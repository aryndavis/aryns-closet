# Copy this file to .env.local and fill in the values from your Supabase project:
# Project Settings -> Data API (project URL) and Project Settings -> API Keys (publishable key).
# The publishable key is safe in browser code; your data and photos are protected by Row Level Security.
# Never put the secret (service_role) key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
